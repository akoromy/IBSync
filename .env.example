# Copy to .env and fill in. The key stays on the server.
AI_API_KEY=
AI_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
AI_MODEL=hunyuan-turbos-latest
# Alternatives:
# AI_BASE_URL=https://tokenhub-intl.tencentmaas.com/v1
